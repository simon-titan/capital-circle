# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated exports (enthalten oft PII, z. B. Mitglieder-CSVs) — nie committen
/exports/

.vercel
.env*

# lokale Agenten-/Plugin-Zustaende
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/.impeccable/
/SUPERVISOR_LOG.md

# generiert von `npm run db:pending` — aus den Einzelmigrationen neu baubar
/supabase/migrations/_JETZT_EINSPIELEN.sql

# im Repo-Root abgelegte Fremddateien (Rechnungen, Screenshots, Emoji-PNGs).
# Bilder, die die App braucht, gehoeren nach /public.
/Rechnung_*.pdf
/Claude.png
/images.png
/ali-2.jpeg
/founder.webp
/*_1f*.png
